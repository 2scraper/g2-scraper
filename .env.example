# Copy this file to `.env` and fill in what you use. Every variable here is
# read by env_config.py — nothing else is read, and everything read is
# documented here (a test asserts the two sets match in both directions).
#
# Precedence: an explicit CLI flag always wins > an exported environment
# variable > this file > the flag's own default. Credentials never belong
# on the command line — that's what this file (or an exported env var) is for.

# 2Captcha API key — shared across captcha solving, the Scraping Browser
# API, the Fingerprint API and the Scraper API (four separately-billed
# products behind one key; proxies are the same key too, billed as
# 2captcha.com/proxy — 2prx.com is a synonym for that product, not a
# separate service/host).
# Get one at https://2captcha.com/setting
# NOT required for a normal local run — this repo's default is a plain
# local headless Chromium with no proxy and no CAPTCHA key at all.
# Worth knowing before you buy credit for this specific site: g2.com is
# protected by DataDome (confirmed live — see g2_parser.py's module
# docstring), and 2Captcha DOES have a dedicated solve path for it —
# DataDomeSliderTask (https://2captcha.com/api-docs/datadome-slider-captcha).
# It is the ONE captcha type in this family with no proxyless option:
# G2_PROXY below (or --proxy/--proxy-file) is REQUIRED, or a DataDome wall
# is just reported as blocked, never actually attempted. No --fingerprint
# needed to make it work — this key alone still buys you the Scraping
# Browser API's own device identity and fingerprints too, which affect
# whether you get challenged in the first place, independent of solving.
TWOCAPTCHA_KEY=

# A proxy for the local engines (Playwright/Selenium/pyppeteer launching
# their own browser) — e.g. http://login:password@host:port, from
# 2captcha.com/proxy. Leave blank to scrape from this machine's own IP.
# REQUIRED alongside TWOCAPTCHA_KEY if you want DataDomeSliderTask to ever
# actually run (see the note above) — --solve-captcha cannot attempt it
# without one.
G2_PROXY=

# A ready-made CDP connection string — most commonly a 2Captcha Scraping
# Browser API session: ws://{login}-zone-scraping_browser-country-{cc}-pid-
# {profileId}:{password}@cb.2captcha.com:9222 (see scraper_api_client.py).
# Opt-in only. Selenium CANNOT use one that carries credentials (see
# selenium_scraper.py's module docstring) — use playwright_scraper.py or
# puppeteer_scraper.py instead.
G2_CDP_ENDPOINT=

# Optional convenience default for --url. Accepts any of the URL shapes
# g2_parser.py can read (see `is_known_scrape_target`):
#   https://www.g2.com/categories/{category-slug}          (+ ?page=N)
#   https://www.g2.com/products/{product-slug}/reviews     (the canonical
#                                                           product page —
#                                                           it always ends
#                                                           in /reviews)
#   https://www.g2.com/products/{product-slug}/pricing
# The scraper auto-detects which one it got and routes to the matching
# parser.
G2_URL=
